# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------
# SAFETY: this project only ever talks to Bybit DEMO trading.
# TRADING_MODE must be exactly "demo" or the application refuses to start.
# The production trading URL does not exist anywhere in this codebase.
# ---------------------------------------------------------------------------
TRADING_MODE=demo

# Bybit DEMO API credentials.
# Generate these from the DEMO account (Bybit -> Demo Trading -> API), NOT from
# your real account. Demo keys do not authenticate against production at all,
# which is the second independent layer of protection.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# OpenAI - used by the LLM trading judge.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Twilio WhatsApp (optional - outbound alerts only).
# Leave blank to disable WhatsApp entirely.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=

# Logging
LOG_LEVEL=INFO
