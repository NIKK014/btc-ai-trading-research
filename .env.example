# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------
# SAFETY: this project only ever talks to Bybit TESTNET.
# TRADING_MODE must be a paper mode (testnet) or the application refuses to start.
# The production trading URL does not exist anywhere in this codebase.
# ---------------------------------------------------------------------------
TRADING_MODE=testnet

# Bybit TESTNET API credentials.
# Register separately at testnet.bybit.com (no KYC, no real funds), fund from
# the faucet, then avatar -> API. Testnet keys are not recognised on mainnet at
# all, which is the second independent layer of protection.
# Note: Bybit EU cannot offer perpetual futures under MiCA, which is why this
# project uses testnet rather than EU demo trading.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# OpenAI - used by the LLM trading judge.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Twilio WhatsApp (optional - outbound alerts only).
# Leave blank to disable WhatsApp entirely.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=

# Logging
LOG_LEVEL=INFO
